# Copy to .env.local for development, and add the same keys in Vercel → Settings → Environment Variables.

# Site
NEXT_PUBLIC_SITE_URL=https://zenetra-landing-preview.vercel.app
NEXT_PUBLIC_SITE_INDEXABLE=false

# Demo requests are emailed to ENQUIRY_TO (comma-separated for several people).
ENQUIRY_TO=sales@example.com
# Must be an address your SMTP provider allows you to send from.
ENQUIRY_FROM=no-reply@example.com

# SMTP. Pick one provider:
#   Zoho Mail (India):  SMTP_HOST=smtp.zoho.in       SMTP_PORT=465  (use an app-specific password)
#   Zoho Mail (global): SMTP_HOST=smtp.zoho.com      SMTP_PORT=465
#   SMTP2GO:            SMTP_HOST=mail.smtp2go.com   SMTP_PORT=587
#   Brevo:              SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587  (SMTP key, not the account password)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional. Defaults to true on port 465, otherwise STARTTLS.
# SMTP_SECURE=true

# Storage for enquiries. Any Postgres works (Neon via the Vercel Marketplace is the easiest).
# Leave empty in development to save to .data/enquiries.jsonl instead.
DATABASE_URL=
