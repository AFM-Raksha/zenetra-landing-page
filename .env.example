# Add these in Vercel → Settings → Environment Variables (tick Production), then redeploy.
# For local development, copy this file to .env.local.

# --- Required ---

# The Gmail account that sends the enquiry emails. Enquiries are also delivered to this inbox.
SMTP_USER=vrafmteam@gmail.com

# A 16-character Google App Password for that account (not the normal Gmail password).
# Create it at Google Account → Security → 2-Step Verification → App passwords.
SMTP_PASS=abcd efgh ijkl mnop

# Added automatically by Vercel when a Blob store is connected to the project. Do not set it by hand.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# --- Optional (leave unset unless you need them) ---

# Send enquiries to a different inbox, or to several people (comma-separated). Default: SMTP_USER.
# ENQUIRY_TO=sales@yourcompany.com,founder@yourcompany.com

# Mail server and port. Defaults: smtp.gmail.com and 465, which are correct for Gmail.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# The site's public address, used for link previews and the sitemap.
NEXT_PUBLIC_SITE_URL=https://zenetra.vercel.app

# Set to true when the site should appear in Google search.
NEXT_PUBLIC_SITE_INDEXABLE=false
